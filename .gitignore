# Data-bearing inference arrays and legacy visual crops stay local. Aggregate
# JSON/CSV/Markdown receipts remain publishable after the governance review.
results/**/*.npz
results/**/*.npy
results/gp_visual_probe/

# Candidate-level coordinate tables are unnecessary for the public software
# release and may reveal locations. Aggregate reports remain versionable.
results/T2_stage*.csv
results/geometric_probe/*.csv
results/geometric_validation/geometric_validation_features.csv
results/geometric_validation/matched_pairs.csv
results/gp_night_benchmark/gp_vs_control.csv
