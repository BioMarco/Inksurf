results/track_a_dev_geometry/*candidates.csv
results/track_a_dev_input_audit*/regions.csv
results/track_a_dev_structural_features/structural_regions.csv
# Sample-level DEV coordinates derived from IR labels. Keep locally for exact
# reruns, but do not publish them with the code repository.
results/fragment_ir_pixel_audit/matched_pixels.csv
results/fragment_ir_profile_model/local_pairs.csv
results/fragment_ir_profile_model/profile_crossfit_predictions.csv
